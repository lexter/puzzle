#!/usr/bin/env bash
# Build gate: compiles the Android app, the shared code for iOS, and every test source set before
# anything is pushed. Install with scripts/install-hooks.sh. Skip once with `git push --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

tasks=(
  :composeApp:assembleDebug
  :composeApp:compileTestKotlinJvm
  :composeApp:compileDebugUnitTestKotlinAndroid
  :composeApp:compileDebugAndroidTestKotlinAndroid
)
# Kotlin/Native iOS targets only build on macOS.
if [[ $(uname) == Darwin ]]; then
  tasks+=(:composeApp:compileKotlinIosSimulatorArm64 :composeApp:compileTestKotlinIosSimulatorArm64)
fi

echo "pre-push: building the Android app, iOS shared code and test sources…"
if ! ./gradlew --quiet "${tasks[@]}"; then
  echo "pre-push: build failed; push aborted." >&2
  exit 1
fi
echo "pre-push: build OK"
